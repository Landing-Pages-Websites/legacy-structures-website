# ------------------------------------------------------------------
# Tracking / verification env vars (Layer 3).
#
# ALL of these are OPTIONAL: the site builds and runs with none of
# them set — each loader renders nothing until its var exists.
# They are minted by the provisioning bot and set in Vercel env,
# not committed to the repo.
# ------------------------------------------------------------------

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX).
# Set by: provisioning bot. Loads gtag after cookie consent, only where tracking
# runs (a production deploy, or the preview opt-in below), so a preview deploy
# never sends hits to the real property.
NEXT_PUBLIC_GA4_ID=


# MEGA site id (the site's UUID). Set by: provisioning bot.
# Sent as `mega_site_id` on every PostHog event so the shared MEGA Websites
# project can split traffic per site. Missing or not a UUID: tracking still
# runs, but the property is omitted and go-live QA fails the site.
NEXT_PUBLIC_MEGA_SITE_ID=

# PostHog is lazy-loaded through the /ingest reverse proxy after consent, into
# the shared MEGA Websites project. The project key and host are constants in
# src/lib/tracking/destination.ts; NEXT_PUBLIC_POSTHOG_KEY and
# NEXT_PUBLIC_POSTHOG_HOST are no longer read, so do not set them.
# Tracking runs only on a production deploy. next.config.ts derives the
# browser's NEXT_PUBLIC_VERCEL_ENV from VERCEL_ENV, which Vercel sets on every
# build, so do not set NEXT_PUBLIC_VERCEL_ENV here: it is overwritten. Unset or
# anything but "production" is off, and the build log says so.

# Set to 1 to run tracking (PostHog and GA4) outside production, for local
# verification only.
NEXT_PUBLIC_MEGA_TRACKING_PREVIEW=

# Set to 1 to turn all PostHog and GA4 tracking off everywhere, even in
# production (no PostHog init, no listeners, gtag.js not loaded). Set by: the
# CMS editor preview env. It wins over NEXT_PUBLIC_MEGA_TRACKING_PREVIEW.
NEXT_PUBLIC_MEGA_TRACKING_DISABLED=
